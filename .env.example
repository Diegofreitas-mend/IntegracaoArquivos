# Copie para .env (que não vai para o Git) e preencha com a URL do Supabase:
# Project Settings > Database > Connection string > "Session pooler" (aceita IPv4),
# trocando [YOUR-PASSWORD] pela senha do banco.
# Sem o .env, a aplicação usa arquivos SQLite locais.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:[YOUR-PASSWORD]@aws-0-REGIAO.pooler.supabase.com:5432/postgres
